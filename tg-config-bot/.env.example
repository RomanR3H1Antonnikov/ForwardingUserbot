BOT_TOKEN=your_bot_token_here

# Path to the userbot directory — absolute OR relative to tg-config-bot/
USERBOT_DIR=..

# Python interpreter used to launch the userbot.
# Auto-detected: prefers ../.venv/Scripts/python.exe (Win) or ../.venv/bin/python (Linux)
# Set explicitly only if the userbot lives in a separate venv.
# USERBOT_PYTHON=/opt/ForwardingUserbot/.venv/bin/python

# Comma-separated Telegram user IDs allowed to use this bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=123456789,987654321
